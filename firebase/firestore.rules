rules_version = '2';
// Titan Crashers · reglas de Firestore (v79)
// La economía (monedas, gemas, cartas, sobres, copas, nivel, victorias) la escribe SOLO el servidor de Cloudflare
// con su cuenta de servicio (que no pasa por estas reglas). El teléfono solo puede escribir su perfil y sus ajustes.
// "ajuste" es para que tú cambies monedas/gemas a mano desde la consola: el servidor lo aplica cuando el jugador entra.
// Todo lo demás de la base (lo de la app de chat vieja) queda bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && okShape() && !request.resource.data.keys().hasAny(serverKeys());
      allow update: if request.auth != null && request.auth.uid == uid
                    && okShape() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverKeys());
      allow delete: if false;

      function serverKeys() {
        return ['econ', 'ajuste', 'trophies', 'maxTrophies', 'lvl', 'wins', 'losses', 'draws', 'matchAt'];
      }
      function okShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','avatar','color','country','save','updatedAt',
                                 'econ','ajuste','trophies','maxTrophies','lvl','wins','losses','draws','matchAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
          && d.avatar is string && d.avatar.size() <= 8
          && d.color is string && d.color.size() <= 9
          && d.country is string && d.country.size() <= 3
          && d.save is map
          && d.updatedAt == request.time;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
